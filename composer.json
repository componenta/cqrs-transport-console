{
    "name": "componenta/cqrs-transport-console",
    "description": "Console worker command for Componenta CQRS command transports",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/app-console": "^3.0",
        "componenta/config": "^2.0.2",
        "componenta/cqrs": "^4.0",
        "componenta/cqrs-transport": "^5.0@dev",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\App\\Transport\\Console\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
